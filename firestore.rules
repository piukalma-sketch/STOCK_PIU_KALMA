rules_version = '2';

// Acceso con usuario y contraseña (Firebase Authentication, correo + contraseña).
//
// Cada persona tiene una "ficha" en users/{uid} = { email, role: 'admin' | 'user', active: true | false }.
//
//  - Para leer o escribir el stock, el catálogo y las fotos hace falta una ficha con active == true.
//  - Solo los administradores (role == 'admin' y active == true) pueden ver todas las fichas, crearlas o
//    modificarlas. Un administrador no puede modificar su propia ficha (así no se puede dejar afuera solo).
//  - Cada persona puede leer SU propia ficha (para que la app le diga "desactivado" en vez de fallar).
//  - Una cuenta nueva de Authentication sin ficha no puede ver nada, ni crearse una ficha a sí misma.
//  - Las fichas no se borran: se desactivan.
//
// La primera ficha de administrador se crea a mano desde la consola de Firebase (la consola no pasa por
// estas reglas). Los pasos están en el README.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }
    function isActive() {
      return hasProfile() && get(profilePath(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return isActive() && get(profilePath(request.auth.uid)).data.role == 'admin';
    }
    function validProfile() {
      return request.resource.data.email is string
        && request.resource.data.role in ['admin', 'user']
        && request.resource.data.active is bool;
    }

    // Documento único donde vive todo: stock, catálogo y últimas cargas.
    match /appdata/shared {
      allow read, write: if isActive();

      // Fotos por combinación de modelo y color.
      match /photos/{photoId} {
        allow read, write: if isActive();
      }
    }

    // ---- Catálogo público (página /catalogo que se manda a los clientes por el chat) ----
    // Es una copia reducida que publica la app: modelo, color, tipo, talles con stock, temporadas, precio y fotos.
    // NO tiene cantidades ni locaciones. Cualquiera puede LEER estas colecciones (sin iniciar sesión), pero solo
    // el personal con ficha activa puede escribirlas. El stock interno (appdata/*) sigue privado.
    match /public_catalog/{id} {
      allow read: if true;
      allow write: if isActive();
    }
    match /public_photos/{id} {
      allow read: if true;
      allow write: if isActive();
    }
    // public_meta/filters: opciones de los filtros de la página pública (lectura pública).
    // public_meta/sigs: control interno de qué ya se publicó (solo personal; entra por la regla de abajo).
    match /public_meta/filters {
      allow read: if true;
    }
    match /public_meta/{id} {
      allow read, write: if isActive();
    }

    // Fichas de usuario.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list: if isAdmin();
      allow create: if isAdmin() && validProfile();
      allow update: if isAdmin() && request.auth.uid != uid && validProfile();
      allow delete: if false;
    }
  }
}
